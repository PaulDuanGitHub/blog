{
  "name": "blog",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "base_path": "/blog"
  },
  "routes": [
    {
      "pattern": "xianzhaoduan.com/blog",
      "zone_name": "xianzhaoduan.com"
    },
    {
      "pattern": "xianzhaoduan.com/blog/*",
      "zone_name": "xianzhaoduan.com"
    }
  ]
}
